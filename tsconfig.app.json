{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // src/data/answers.json is imported directly (ADR-0001: the corpus is a
    // committed, diffable data file, not generated at build time).
    "resolveJsonModule": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    // Strict is the point. ADR-0003's QST-TYPESCRIPT argued for types from
    // one concrete case: the scorer's three-state union. Loosening these
    // would keep the syntax and discard the reason for it.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
